---
---
<div
  id="scroll-scene"
  class="pointer-events-none fixed inset-0 z-0 overflow-hidden bg-brand-900"
  aria-hidden="true"
>
  <canvas id="scroll-scene-canvas" class="h-full w-full"></canvas>
  <div class="absolute inset-0 bg-brand-900/10"></div>
</div>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const FRAME_COUNT = 121;
  const framePath = (index: number) =>
    `/scroll-scene/frame-${String(index + 1).padStart(3, "0")}.jpg`;

  const canvas = document.getElementById("scroll-scene-canvas") as HTMLCanvasElement | null;
  const ctx = canvas?.getContext("2d") ?? null;

  if (canvas && ctx) {
    const state = { frame: 0 };
    const images: HTMLImageElement[] = [];

    function drawFrame(index: number) {
      const img = images[index];
      if (!canvas || !ctx || !img || !img.complete || img.naturalWidth === 0) return;

      const canvasRatio = canvas.width / canvas.height;
      const imgRatio = img.naturalWidth / img.naturalHeight;
      let drawWidth: number;
      let drawHeight: number;

      if (imgRatio > canvasRatio) {
        drawHeight = canvas.height;
        drawWidth = drawHeight * imgRatio;
      } else {
        drawWidth = canvas.width;
        drawHeight = drawWidth / imgRatio;
      }

      const offsetX = (canvas.width - drawWidth) / 2;
      const offsetY = (canvas.height - drawHeight) / 2;

      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.drawImage(img, offsetX, offsetY, drawWidth, drawHeight);
    }

    function resizeCanvas() {
      if (!canvas) return;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(window.innerWidth * dpr);
      canvas.height = Math.round(window.innerHeight * dpr);
      drawFrame(Math.round(state.frame));
    }

    window.addEventListener("resize", resizeCanvas);
    resizeCanvas();

    for (let i = 0; i < FRAME_COUNT; i++) {
      const img = new Image();
      img.src = framePath(i);
      img.onload = () => {
        if (Math.round(state.frame) === i) drawFrame(i);
      };
      images.push(img);
    }

    const mm = gsap.matchMedia();

    mm.add("(prefers-reduced-motion: no-preference)", () => {
      gsap.to(state, {
        frame: FRAME_COUNT - 1,
        ease: "none",
        scrollTrigger: {
          trigger: document.body,
          start: "top top",
          end: "bottom bottom",
          scrub: 0.6,
        },
        onUpdate: () => drawFrame(Math.round(state.frame)),
      });

      window.addEventListener("load", () => ScrollTrigger.refresh());
    });

    mm.add("(prefers-reduced-motion: reduce)", () => {
      const lastIndex = FRAME_COUNT - 1;
      const showLastFrame = () => drawFrame(lastIndex);
      if (images[lastIndex].complete) showLastFrame();
      else images[lastIndex].onload = showLastFrame;
    });
  }
</script>
