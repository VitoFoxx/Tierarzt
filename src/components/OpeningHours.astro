---
// dayIndex folgt JS Date.getDay(): 0 = Sonntag ... 6 = Samstag
const hours = [
  { day: "Montag", time: "08:00–18:00 Uhr", dayIndex: 1 },
  { day: "Dienstag", time: "08:00–18:00 Uhr", dayIndex: 2 },
  { day: "Mittwoch", time: "08:00–13:00 Uhr", dayIndex: 3 },
  { day: "Donnerstag", time: "08:00–18:00 Uhr", dayIndex: 4 },
  { day: "Freitag", time: "08:00–18:00 Uhr", dayIndex: 5 },
  { day: "Samstag", time: "09:00–12:00 Uhr", dayIndex: 6 },
  { day: "Sonntag", time: "geschlossen", dayIndex: 0 },
];
---
<div class="rounded-2xl border border-brand-100 bg-white p-6 shadow-sm">
  <h3 class="text-lg">Öffnungszeiten</h3>
  <dl id="opening-hours-list" class="mt-4 space-y-2 text-sm">
    {hours.map(({ day, time, dayIndex }) => (
      <div
        data-day={dayIndex}
        class="flex justify-between rounded-lg border-b border-brand-50 px-2 py-2 transition-colors last:border-none last:pb-0"
      >
        <dt class="text-brand-900/70">{day}</dt>
        <dd class="font-medium text-brand-900">{time}</dd>
      </div>
    ))}
  </dl>
  <p class="mt-4 text-xs text-brand-900/50">Platzhalter-Öffnungszeiten – bitte durch echte Praxiszeiten ersetzen.</p>
</div>

<script>
  document.addEventListener("astro:page-load", () => {
    const today = new Date().getDay().toString();
    const row = document.querySelector(`#opening-hours-list [data-day="${today}"]`);
    if (row) {
      row.classList.add("bg-brand-50");
      row.querySelector("dt")?.classList.add("font-semibold", "text-brand-700");
      row.querySelector("dd")?.classList.add("text-brand-700");
    }
  });
</script>
