---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import TeamMemberCard from "../components/TeamMemberCard.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
import NoticeModal from "../components/NoticeModal.astro";
import PhilosophyBand from "../components/PhilosophyBand.astro";
import PawDivider from "../components/PawDivider.astro";

const team = (await getCollection("team")).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="Über uns" description="Lernen Sie unsere Praxis und unser Team kennen.">
  <NoticeModal id="ueber-uns" message="Hier ist Platz für das Personal und die tierischen Helfer." />
  <div class="bg-gradient-to-b from-brand-100 via-brand-50/60 to-white">
    <div class="mx-auto max-w-6xl px-4 pb-8 pt-16">
      <div class="max-w-2xl">
        <h1 class="text-3xl md:text-4xl">Über uns</h1>
        <p class="mt-3 text-brand-900/70">
          Platzhaltertext: Vorstellung der Praxis, Philosophie und Geschichte.
        </p>
      </div>
    </div>
  </div>

  <PhilosophyBand
    eyebrow="Unsere Philosophie"
    statement="Platzhaltertext: Vertrauen entsteht nicht durch Technik allein, sondern dadurch, dass sich Tier und Halter bei uns wirklich gesehen fühlen."
  />

  <PawDivider />
  <section class="mx-auto max-w-6xl px-4 pb-16 pt-2">
    <h2 class="mb-6 text-xl">Unser Team</h2>
    <ScrollReveal class="grid gap-6 sm:grid-cols-2 md:grid-cols-3">
      {team.map((member) => (
        <TeamMemberCard name={member.data.name} role={member.data.role} photo={member.data.photo} />
      ))}
    </ScrollReveal>
  </section>
</BaseLayout>
