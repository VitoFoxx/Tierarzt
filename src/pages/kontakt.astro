---
import BaseLayout from "../layouts/BaseLayout.astro";
import OpeningHours from "../components/OpeningHours.astro";
import ContactForm from "../components/ContactForm.astro";
import PawDivider from "../components/PawDivider.astro";
---
<BaseLayout title="Kontakt" description="Kontaktieren Sie uns oder finden Sie unsere Praxis.">
  <div class="bg-gradient-to-b from-brand-100 via-brand-50/60 to-white">
    <div class="mx-auto max-w-6xl px-4 pb-8 pt-16">
      <div class="max-w-2xl">
        <h1 class="text-3xl md:text-4xl">Kontakt</h1>
        <p class="mt-3 text-brand-900/70">
          Platzhaltertext: Wir freuen uns auf Ihre Nachricht oder Ihren Anruf.
        </p>
      </div>
    </div>
  </div>
  <PawDivider />

  <section class="mx-auto max-w-6xl px-4 pb-16 pt-2">
    <div class="grid gap-8 lg:grid-cols-2">
      <div class="space-y-8">
        <div class="rounded-2xl border border-brand-100 bg-white p-6 shadow-sm">
          <h2 class="text-lg">Adresse &amp; Anfahrt</h2>
          <p class="mt-2 text-sm text-brand-900/70">
            Tierarztpraxis Musterstadt<br />
            Musterstraße 12<br />
            12345 Musterstadt
          </p>
          <p class="mt-2 text-sm text-brand-900/70">
            Telefon: <a href="tel:+490000000000" class="text-brand-600 hover:text-brand-700">0000 / 000 000</a><br />
            E-Mail: <a href="mailto:info@example.com" class="text-brand-600 hover:text-brand-700">info@example.com</a>
          </p>

          <div class="mt-4 aspect-video w-full overflow-hidden rounded-xl border border-brand-100 bg-brand-50">
            <iframe
              title="Kartenausschnitt (Platzhalter)"
              src="https://www.openstreetmap.org/export/embed.html?bbox=13.4,52.5,13.42,52.52&layer=mapnik"
              class="h-full w-full"
              loading="lazy"
            ></iframe>
          </div>
          <p class="mt-2 text-xs text-brand-900/50">Platzhalter-Kartenausschnitt – durch echte Praxisadresse ersetzen.</p>
        </div>

        <OpeningHours />
      </div>

      <div>
        <h2 class="mb-4 text-lg">Nachricht senden</h2>
        <ContactForm />
      </div>
    </div>
  </section>
</BaseLayout>
