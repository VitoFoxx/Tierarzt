---
interface Props {
  title: string;
  summary: string;
  href?: string;
}
const { title, summary, href } = Astro.props;
---
<article class="flex flex-col gap-3 rounded-2xl border border-brand-100 bg-white p-6 shadow-sm transition-shadow hover:shadow-md">
  <div class="flex h-10 w-10 items-center justify-center rounded-full bg-brand-100 text-brand-700">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
  </div>
  <h3 class="text-lg">{title}</h3>
  <p class="text-sm text-brand-900/70">{summary}</p>
  {href && (
    <a href={href} class="mt-auto text-sm font-semibold text-brand-600 hover:text-brand-700">
      Mehr erfahren &rarr;
    </a>
  )}
</article>
