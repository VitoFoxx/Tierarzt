---
const hours = [
  { day: "Montag", time: "08:00–18:00 Uhr" },
  { day: "Dienstag", time: "08:00–18:00 Uhr" },
  { day: "Mittwoch", time: "08:00–13:00 Uhr" },
  { day: "Donnerstag", time: "08:00–18:00 Uhr" },
  { day: "Freitag", time: "08:00–18:00 Uhr" },
  { day: "Samstag", time: "09:00–12:00 Uhr" },
  { day: "Sonntag", time: "geschlossen" },
];
---
<div class="rounded-2xl border border-brand-100 bg-white p-6 shadow-sm">
  <h3 class="text-lg">Öffnungszeiten</h3>
  <dl class="mt-4 space-y-2 text-sm">
    {hours.map(({ day, time }) => (
      <div class="flex justify-between border-b border-brand-50 pb-2 last:border-none last:pb-0">
        <dt class="text-brand-900/70">{day}</dt>
        <dd class="font-medium text-brand-900">{time}</dd>
      </div>
    ))}
  </dl>
  <p class="mt-4 text-xs text-brand-900/50">Platzhalter-Öffnungszeiten – bitte durch echte Praxiszeiten ersetzen.</p>
</div>
