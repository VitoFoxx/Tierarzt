---
interface Props {
  name: string;
  role: string;
  photo?: string;
}
const { name, role, photo } = Astro.props;
---
<article class="flex flex-col items-center gap-3 rounded-2xl border border-brand-100 bg-white p-6 text-center shadow-sm">
  <div class="flex h-24 w-24 items-center justify-center overflow-hidden rounded-full bg-brand-100 text-brand-700">
    {photo ? (
      <img src={photo} alt={name} class="h-full w-full object-cover" />
    ) : (
      <span class="text-2xl font-semibold">{name.charAt(0)}</span>
    )}
  </div>
  <div>
    <p class="font-semibold text-brand-900">{name}</p>
    <p class="text-sm text-brand-900/60">{role}</p>
  </div>
</article>
