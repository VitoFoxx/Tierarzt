---
---
<div
  id="scroll-scene"
  class="pointer-events-none fixed inset-0 z-0 overflow-hidden"
  aria-hidden="true"
>
  <svg
    viewBox="0 0 1600 900"
    preserveAspectRatio="xMidYMid slice"
    class="h-full w-full"
  >
    <defs>
      <linearGradient id="scene-sky" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#eef7f5" />
        <stop offset="100%" stop-color="#fff8ed" />
      </linearGradient>
    </defs>

    <rect x="0" y="0" width="1600" height="900" fill="url(#scene-sky)" />

    <circle id="scene-sun" cx="220" cy="190" r="70" fill="#ffc06a" opacity="0.9" />

    <g id="scene-cloud-1" fill="#ffffff" opacity="0.85">
      <ellipse cx="520" cy="160" rx="70" ry="30" />
      <ellipse cx="580" cy="145" rx="50" ry="26" />
      <ellipse cx="460" cy="150" rx="45" ry="24" />
    </g>

    <g id="scene-cloud-2" fill="#ffffff" opacity="0.75">
      <ellipse cx="1150" cy="260" rx="60" ry="26" />
      <ellipse cx="1200" cy="248" rx="42" ry="22" />
      <ellipse cx="1100" cy="250" rx="38" ry="20" />
    </g>

    <path
      id="scene-hills-back"
      d="M0,760 C 260,700 480,720 760,745 C 1040,770 1320,730 1600,760 L1600,900 L0,900 Z"
      fill="#d6ebe6"
    />
    <path
      id="scene-hills-front"
      d="M0,820 C 300,780 560,800 820,815 C 1120,832 1380,800 1600,825 L1600,900 L0,900 Z"
      fill="#aed7cd"
    />

    <g id="scene-pawprints" fill="#26645a">
      <g class="paw" data-index="0" transform="translate(160,700)" opacity="0">
        <ellipse cx="0" cy="0" rx="7" ry="9" />
        <ellipse cx="-9" cy="-10" rx="3" ry="4" />
        <ellipse cx="9" cy="-10" rx="3" ry="4" />
      </g>
      <g class="paw" data-index="1" transform="translate(300,712)" opacity="0">
        <ellipse cx="0" cy="0" rx="7" ry="9" />
        <ellipse cx="-9" cy="-10" rx="3" ry="4" />
        <ellipse cx="9" cy="-10" rx="3" ry="4" />
      </g>
      <g class="paw" data-index="2" transform="translate(440,696)" opacity="0">
        <ellipse cx="0" cy="0" rx="7" ry="9" />
        <ellipse cx="-9" cy="-10" rx="3" ry="4" />
        <ellipse cx="9" cy="-10" rx="3" ry="4" />
      </g>
      <g class="paw" data-index="3" transform="translate(580,708)" opacity="0">
        <ellipse cx="0" cy="0" rx="7" ry="9" />
        <ellipse cx="-9" cy="-10" rx="3" ry="4" />
        <ellipse cx="9" cy="-10" rx="3" ry="4" />
      </g>
      <g class="paw" data-index="4" transform="translate(720,692)" opacity="0">
        <ellipse cx="0" cy="0" rx="7" ry="9" />
        <ellipse cx="-9" cy="-10" rx="3" ry="4" />
        <ellipse cx="9" cy="-10" rx="3" ry="4" />
      </g>
      <g class="paw" data-index="5" transform="translate(860,702)" opacity="0">
        <ellipse cx="0" cy="0" rx="7" ry="9" />
        <ellipse cx="-9" cy="-10" rx="3" ry="4" />
        <ellipse cx="9" cy="-10" rx="3" ry="4" />
      </g>
      <g class="paw" data-index="6" transform="translate(1000,688)" opacity="0">
        <ellipse cx="0" cy="0" rx="7" ry="9" />
        <ellipse cx="-9" cy="-10" rx="3" ry="4" />
        <ellipse cx="9" cy="-10" rx="3" ry="4" />
      </g>
      <g class="paw" data-index="7" transform="translate(1140,696)" opacity="0">
        <ellipse cx="0" cy="0" rx="7" ry="9" />
        <ellipse cx="-9" cy="-10" rx="3" ry="4" />
        <ellipse cx="9" cy="-10" rx="3" ry="4" />
      </g>
    </g>

    <g id="scene-dog" transform="translate(120,635)">
      <ellipse id="scene-dog-tail" cx="-34" cy="-4" rx="12" ry="5" fill="#4f9d8b" transform="rotate(-20 -34 -4)" />
      <ellipse cx="0" cy="0" rx="34" ry="18" fill="#347e6e" />
      <circle cx="32" cy="-10" r="14" fill="#347e6e" />
      <circle cx="37" cy="-14" r="3.2" fill="#1a3733" />
      <ellipse id="scene-dog-ear" cx="24" cy="-22" rx="6" ry="9" fill="#215049" transform="rotate(-15 24 -22)" />
      <g id="scene-dog-legs" fill="#215049">
        <rect x="-24" y="12" width="7" height="14" rx="3" />
        <rect x="-4" y="12" width="7" height="14" rx="3" />
        <rect x="14" y="12" width="7" height="14" rx="3" />
      </g>
    </g>

    <g id="scene-building" opacity="0" transform="translate(1360,560) scale(0.7)" style="transform-origin: 0px 130px;">
      <rect x="-90" y="0" width="180" height="130" rx="6" fill="#eef7f5" stroke="#26645a" stroke-width="4" />
      <polygon points="-102,0 0,-70 102,0" fill="#26645a" />
      <rect x="-16" y="60" width="32" height="70" rx="3" fill="#26645a" />
      <rect x="-64" y="30" width="30" height="26" rx="3" fill="#ffffff" stroke="#26645a" stroke-width="3" />
      <rect x="34" y="30" width="30" height="26" rx="3" fill="#ffffff" stroke="#26645a" stroke-width="3" />
      <g transform="translate(0,-28)">
        <rect x="-3" y="-16" width="6" height="24" fill="#fa800e" />
        <rect x="-12" y="-7" width="24" height="6" fill="#fa800e" />
      </g>
    </g>
  </svg>
</div>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();

  mm.add("(prefers-reduced-motion: no-preference)", () => {
    const paws = gsap.utils.toArray<SVGGElement>("#scene-pawprints .paw");

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: document.body,
        start: "top top",
        end: "bottom bottom",
        scrub: 0.6,
      },
      defaults: { ease: "none" },
    });

    tl.to("#scene-sun", { x: 900, y: -90, duration: 1 }, 0)
      .to("#scene-cloud-1", { x: -260, duration: 1 }, 0)
      .to("#scene-cloud-2", { x: 220, duration: 1 }, 0)
      .to("#scene-hills-back", { x: -80, duration: 1 }, 0)
      .to("#scene-hills-front", { x: -140, duration: 1 }, 0)
      .to("#scene-dog", { x: 1230, y: -55, duration: 0.92 }, 0)
      .fromTo(
        "#scene-building",
        { opacity: 0, scale: 0.7 },
        { opacity: 1, scale: 1, duration: 0.28 },
        0.74
      );

    paws.forEach((paw, index) => {
      tl.to(paw, { opacity: 1, duration: 0.05 }, index / paws.length);
    });

    gsap.to("#scene-dog-legs", {
      rotate: 8,
      transformOrigin: "top center",
      duration: 0.35,
      repeat: -1,
      yoyo: true,
      ease: "sine.inOut",
    });
    gsap.to("#scene-dog-tail", {
      rotate: 18,
      transformOrigin: "right center",
      duration: 0.5,
      repeat: -1,
      yoyo: true,
      ease: "sine.inOut",
    });

    window.addEventListener("load", () => ScrollTrigger.refresh());
  });

  mm.add("(prefers-reduced-motion: reduce)", () => {
    gsap.set("#scene-building", { opacity: 1, scale: 1 });
    gsap.set("#scene-dog", { x: 1230, y: -55 });
    gsap.set("#scene-pawprints .paw", { opacity: 1 });
  });
</script>
