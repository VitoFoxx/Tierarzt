---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ServiceCard from "../components/ServiceCard.astro";
import OpeningHours from "../components/OpeningHours.astro";

const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="Startseite">
  <Hero
    title="Einfühlsame tierärztliche Versorgung für Ihr Tier"
    subtitle="Von der Vorsorge bis zur Notfallbehandlung – wir sind für Hunde, Katzen und Kleintiere da. Platzhaltertext für die Startseiten-Einleitung."
    primaryCta={{ label: "Termin anfragen", href: "/kontakt" }}
    secondaryCta={{ label: "Leistungen ansehen", href: "/leistungen" }}
  />

  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="mb-10 max-w-2xl">
      <h2 class="text-2xl md:text-3xl">Unsere Leistungen im Überblick</h2>
      <p class="mt-2 text-brand-900/70">Platzhaltertext: kurze Einleitung zum Leistungsangebot der Praxis.</p>
    </div>
    <div class="grid gap-6 md:grid-cols-3">
      {services.map((service) => (
        <ServiceCard title={service.data.title} summary={service.data.summary} href="/leistungen" />
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16">
    <div class="grid gap-6 md:grid-cols-2">
      <div class="rounded-2xl border border-brand-100 bg-brand-50 p-6">
        <h2 class="text-xl">Warum unsere Praxis?</h2>
        <ul class="mt-4 space-y-2 text-sm text-brand-900/70">
          <li>Platzhalter: Erfahrenes, einfühlsames Team</li>
          <li>Platzhalter: Moderne diagnostische Ausstattung</li>
          <li>Platzhalter: Kurzfristige Terminvergabe</li>
        </ul>
      </div>
      <OpeningHours />
    </div>
  </section>
</BaseLayout>
